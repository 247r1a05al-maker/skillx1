/* ==========================================
   THEME SYSTEM - NORMAL & ELITE MODES
   ========================================== */

/* ==========================================
   ROOT VARIABLES
   ========================================== */

:root {
  /* Normal Mode Colors */
  --color-bg-primary: #ffffff;
  --color-bg-secondary: #f9fafb;
  --color-bg-tertiary: #f3f4f6;
  --color-text-primary: #1f2937;
  --color-text-secondary: #6b7280;
  --color-text-tertiary: #9ca3af;
  --color-border: #e5e7eb;
  --color-accent: #4f46e5;
  --color-accent-light: #818cf8;
  --color-success: #10b981;
  --color-warning: #f59e0b;
  --color-danger: #ef4444;

  /* Shadow defaults */
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
}

/* ==========================================
   ELITE MODE THEME
   ========================================== */

.theme-elite {
  --color-bg-primary: #0a0f1c;
  --color-bg-secondary: #0d1326;
  --color-bg-tertiary: #111a33;
  --color-text-primary: #00f0ff;
  --color-text-secondary: #00d9ff;
  --color-text-tertiary: #00bfff;
  --color-border: #00d9ff;
  --color-accent: #00f0ff;
  --color-accent-light: #00d9ff;
  --color-success: #00ff88;
  --color-warning: #ffaa00;
  --color-danger: #ff0055;

  /* Elite Mode Shadows - Glowing */
  --shadow-sm: 0 0 15px rgba(0, 240, 255, 0.3);
  --shadow-md: 0 0 25px rgba(0, 217, 255, 0.35);
  --shadow-lg: 0 0 40px rgba(0, 191, 255, 0.4);
  --shadow-xl: 0 0 50px rgba(0, 240, 255, 0.35);
}

/* ==========================================
   BODY & ROOT STYLES
   ========================================== */

html.theme-elite {
  background: #0a0f1c;
  color: var(--color-text-primary);
}

html.theme-normal {
  background: #f3f4f6;
  color: var(--color-text-primary);
}

body {
  transition: background-color 0.4s ease, color 0.4s ease;
}

html.theme-elite body {
  background: #0a0f1c;
  color: #00e5ff;
}

html.theme-normal body {
  background: #f3f4f6;
  color: #1f2937;
}

/* ==========================================
   SCROLLBAR THEMING
   ========================================== */

html.theme-elite ::-webkit-scrollbar {
  width: 8px;
}

html.theme-elite ::-webkit-scrollbar-track {
  background: transparent;
}

html.theme-elite ::-webkit-scrollbar-thumb {
  background: rgba(0, 229, 255, 0.3);
  border-radius: 4px;
}

html.theme-elite ::-webkit-scrollbar-thumb:hover {
  background: rgba(0, 229, 255, 0.5);
  box-shadow: 0 0 10px rgba(0, 229, 255, 0.5);
}

/* ==========================================
   CARD STYLES
   ========================================== */

.theme-card {
  transition: all 0.3s ease;
}

.theme-normal .theme-card {
  background: var(--color-bg-primary);
  border: 1px solid var(--color-border);
  box-shadow: var(--shadow-sm);
}

.theme-elite .theme-card {
  background: linear-gradient(
    135deg,
    rgba(0, 15, 45, 0.9) 0%,
    rgba(5, 20, 50, 0.8) 50%,
    rgba(0, 10, 30, 0.9) 100%
  );
  border: 1.5px solid rgba(0, 217, 255, 0.4);
  box-shadow: 
    var(--shadow-md), 
    inset 0 1px 0 rgba(0, 240, 255, 0.2),
    0 0 20px rgba(0, 217, 255, 0.15);
  backdrop-filter: blur(15px);
  position: relative;
}

.theme-elite .theme-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(
    135deg,
    rgba(0, 240, 255, 0.05) 0%,
    transparent 50%,
    rgba(0, 191, 255, 0.05) 100%
  );
  pointer-events: none;
  border-radius: inherit;
}

.theme-elite .theme-card:hover {
  border-color: rgba(0, 240, 255, 0.7);
  box-shadow: 
    var(--shadow-lg), 
    inset 0 1px 0 rgba(0, 240, 255, 0.3),
    0 0 30px rgba(0, 217, 255, 0.25);
}

/* ==========================================
   BUTTON STYLES
   ========================================== */

.btn-primary {
  transition: all 0.3s ease;
}

.theme-normal .btn-primary {
  background: var(--color-accent);
  color: white;
  box-shadow: var(--shadow-sm);
}

.theme-normal .btn-primary:hover {
  background: #4338ca;
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}

.theme-elite .btn-primary {
  background: linear-gradient(135deg, #00f0ff 0%, #00d9ff 50%, #00bfff 100%);
  color: #0a0f1c;
  font-weight: 600;
  box-shadow: 
    var(--shadow-md), 
    inset 0 1px 0 rgba(255, 255, 255, 0.2),
    0 0 20px rgba(0, 217, 255, 0.3);
  border: 1.5px solid rgba(0, 240, 255, 0.6);
  position: relative;
  overflow: hidden;
}

.theme-elite .btn-primary::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.4),
    transparent
  );
  transition: left 0.5s;
}

.theme-elite .btn-primary:hover::before {
  left: 100%;
}

.theme-elite .btn-primary:hover {
  box-shadow: 
    var(--shadow-lg),
    inset 0 1px 0 rgba(255, 255, 255, 0.3),
    0 0 30px rgba(0, 240, 255, 0.5);
  transform: translateY(-2px);
  border-color: rgba(0, 240, 255, 0.9);
}

/* ==========================================
   INPUT STYLES
   ========================================== */

.theme-input {
  transition: all 0.3s ease;
}

.theme-normal .theme-input {
  background: var(--color-bg-primary);
  border: 1px solid var(--color-border);
  color: var(--color-text-primary);
}

.theme-normal .theme-input:focus {
  border-color: var(--color-accent);
  box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
}

.theme-elite .theme-input {
  background: rgba(20, 30, 60, 0.8);
  border: 1.5px solid #ffd700;
  color: #ffd700;
  backdrop-filter: blur(15px);
  box-shadow: inset 0 0 10px rgba(255, 215, 0, 0.1);
}

.theme-elite .theme-input:focus {
  border-color: #ffed4e;
  box-shadow: 
    inset 0 0 10px rgba(255, 215, 0, 0.15),
    0 0 20px rgba(255, 215, 0, 0.5);
  background: rgba(20, 30, 60, 0.95);
}

.theme-elite .theme-input::placeholder {
  color: rgba(255, 215, 0, 0.6);
}

/* ==========================================
   AGGRESSIVE BLACK TEXT TO WHITE OVERRIDE
   ========================================== */

/* FORCE ALL TEXT WHITE IN ELITE MODE - NO EXCEPTIONS */
html.theme-elite,
html.theme-elite * {
  color: #ffffff !important;
}

/* Override Tailwind text color classes */
html.theme-elite .text-black,
html.theme-elite .text-gray-900,
html.theme-elite .text-gray-800,
html.theme-elite .text-gray-700,
html.theme-elite .text-slate-900,
html.theme-elite .text-slate-800,
html.theme-elite .text-neutral-900 {
  color: #ffffff !important;
}

/* Override dark gray to light */
html.theme-elite .text-gray-600,
html.theme-elite .text-gray-500,
html.theme-elite .text-slate-700,
html.theme-elite .text-slate-600 {
  color: #ffffff !important;
}

/* Force all headings white */
html.theme-elite h1,
html.theme-elite h2,
html.theme-elite h3,
html.theme-elite h4,
html.theme-elite h5,
html.theme-elite h6,
html.theme-elite .heading,
html.theme-elite .title {
  color: #ffffff !important;
}

/* Force all paragraph text white */
html.theme-elite p,
html.theme-elite span,
html.theme-elite div,
html.theme-elite a,
html.theme-elite li,
html.theme-elite label,
html.theme-elite button,
html.theme-elite .text,
html.theme-elite .content {
  color: #ffffff !important;
}

/* Table text white */
html.theme-elite table,
html.theme-elite td,
html.theme-elite th,
html.theme-elite tr {
  color: #ffffff !important;
}

/* Input text - Gold/Yellow */
html.theme-elite input,
html.theme-elite textarea,
html.theme-elite select {
  color: #ffd700 !important;
}

/* Override inline style colors */
html.theme-elite [style*="color"] {
  color: #ffffff !important;
}

/* Keep special theme colors for specific classes */
html.theme-elite .theme-text-primary {
  color: #00f0ff !important;
}

html.theme-elite .theme-text-secondary {
  color: #00d9ff !important;
}

html.theme-elite .theme-text-tertiary {
  color: #00bfff !important;
}

html.theme-elite .theme-text-accent {
  color: #ffd700 !important;
}

/* Button text stays dark */
html.theme-elite button {
  color: #ffffff !important;
}

html.theme-elite .btn-primary {
  color: #0a0f1c !important;
}

/* ==========================================
   BADGE STYLES
   ========================================== */

.badge-primary {
  transition: all 0.3s ease;
}

.theme-normal .badge-primary {
  background: rgba(79, 70, 229, 0.1);
  color: var(--color-accent);
  border: 1px solid var(--color-accent);
}

.theme-elite .badge-primary {
  background: linear-gradient(
    135deg,
    rgba(0, 217, 255, 0.2) 0%,
    rgba(0, 191, 255, 0.1) 100%
  );
  color: #00f0ff;
  border: 1px solid rgba(0, 240, 255, 0.5);
  box-shadow: 
    inset 0 0 10px rgba(0, 217, 255, 0.15),
    0 0 10px rgba(0, 217, 255, 0.1);
  font-weight: 500;
}

/* ==========================================
   ANIMATION CLASSES
   ========================================== */

@keyframes elite-glow {
  0%, 100% {
    box-shadow: 0 0 25px rgba(0, 217, 255, 0.4);
  }
  50% {
    box-shadow: 0 0 40px rgba(0, 240, 255, 0.6);
  }
}

@keyframes neon-border {
  0%, 100% {
    border-color: rgba(0, 217, 255, 0.5);
  }
  50% {
    border-color: rgba(0, 240, 255, 0.9);
  }
}

@keyframes gradient-shift {
  0% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 50%;
  }
}

.theme-elite .elite-glow {
  animation: elite-glow 2s ease-in-out infinite;
}

.theme-elite .neon-border {
  animation: neon-border 3s ease-in-out infinite;
}

/* ==========================================
   TEXT COLORS
   ========================================== */

.theme-text-primary {
  color: var(--color-text-primary);
  transition: color 0.3s ease;
}

.theme-elite .theme-text-primary {
  text-shadow: 0 0 10px rgba(255, 200, 0, 0.6), 0 0 20px rgba(0, 240, 255, 0.3);
}

.theme-text-secondary {
  color: var(--color-text-secondary);
  transition: color 0.3s ease;
}

.theme-elite .theme-text-secondary {
  text-shadow: 0 0 8px rgba(0, 217, 255, 0.4);
}

.theme-text-tertiary {
  color: var(--color-text-tertiary);
  transition: color 0.3s ease;
}

.theme-elite .theme-text-tertiary {
  text-shadow: 0 0 6px rgba(0, 191, 255, 0.3);
}

/* ==========================================
   BACKGROUND COLORS
   ========================================== */

.theme-bg-primary {
  background: var(--color-bg-primary);
  transition: background 0.3s ease;
}

.theme-bg-secondary {
  background: var(--color-bg-secondary);
  transition: background 0.3s ease;
}

.theme-bg-tertiary {
  background: var(--color-bg-tertiary);
  transition: background 0.3s ease;
}

/* ==========================================
   BORDER COLORS
   ========================================== */

.theme-border {
  border-color: var(--color-border);
  transition: border-color 0.3s ease;
}

/* ==========================================
   HOVER EFFECTS
   ========================================== */

.theme-hover-glow {
  transition: all 0.3s ease;
}

.theme-elite .theme-hover-glow:hover {
  box-shadow: var(--shadow-lg);
  transform: translateY(-2px);
}

.theme-normal .theme-hover-glow:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}

/* ==========================================
   NAVBAR STYLES
   ========================================== */

.theme-navbar {
  transition: all 0.3s ease;
}

.theme-normal .theme-navbar {
  background: rgba(255, 255, 255, 0.95);
  border-bottom: 1px solid var(--color-border);
  box-shadow: var(--shadow-sm);
}

.theme-elite .theme-navbar {
  background: linear-gradient(
    180deg,
    rgba(10, 15, 28, 0.9) 0%,
    rgba(5, 10, 25, 0.7) 100%
  );
  border-bottom: 1.5px solid rgba(0, 217, 255, 0.3);
  box-shadow: 
    var(--shadow-md),
    0 4px 20px rgba(0, 217, 255, 0.1);
  backdrop-filter: blur(15px);
}

/* ==========================================
   SIDEBAR STYLES
   ========================================== */

.theme-sidebar {
  transition: all 0.3s ease;
}

.theme-normal .theme-sidebar {
  background: rgba(255, 255, 255, 0.95);
  border-right: 1px solid var(--color-border);
  box-shadow: var(--shadow-sm);
}

.theme-elite .theme-sidebar {
  background: linear-gradient(
    180deg,
    rgba(10, 15, 28, 0.95) 0%,
    rgba(5, 10, 25, 0.8) 100%
  );
  border-right: 1.5px solid rgba(0, 217, 255, 0.3);
  box-shadow: 
    var(--shadow-md),
    4px 0 20px rgba(0, 217, 255, 0.1);
  backdrop-filter: blur(15px);
}

/* FORCE ALL SIDEBAR TEXT WHITE IN ELITE MODE */
.theme-elite .theme-sidebar,
.theme-elite .theme-sidebar * {
  color: #ffffff !important;
}

.theme-elite .theme-sidebar button,
.theme-elite .theme-sidebar span,
.theme-elite .theme-sidebar h1,
.theme-elite .theme-sidebar p,
.theme-elite .theme-sidebar label {
  color: #ffffff !important;
}

.theme-sidebar-item {
  transition: all 0.3s ease;
}

.theme-normal .theme-sidebar-item:hover {
  background: var(--color-bg-tertiary);
}

.theme-elite .theme-sidebar-item {
  color: #ffffff !important;
}

.theme-elite .theme-sidebar-item span {
  color: #ffffff !important;
}

.theme-elite .theme-sidebar-item:hover {
  background: rgba(0, 217, 255, 0.12);
  border-left: 3px solid var(--color-accent);
  box-shadow: inset 0 0 15px rgba(0, 217, 255, 0.08);
  color: #ffffff !important;
}

/* ==========================================
   FORCE ALL TEXT WHITE IN ELITE MODE
   ========================================== */

html.theme-elite,
html.theme-elite body,
html.theme-elite * {
  color: #ffffff !important;
}

/* ==========================================
   STAT CARD ANIMATION
   ========================================== */

.stat-card {
  transition: all 0.3s ease;
}

.theme-elite .stat-card {
  position: relative;
  overflow: hidden;
}

.theme-elite .stat-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(0, 229, 255, 0.1),
    transparent
  );
  animation: shimmer 3s infinite;
}

@keyframes shimmer {
  0% {
    left: -100%;
  }
  100% {
    left: 100%;
  }
}

/* ==========================================
   SMOOTH TRANSITIONS
   ========================================== */

* {
  transition-property: background-color, border-color, box-shadow, color;
  transition-duration: 0.3s;
  transition-timing-function: ease;
}

button,
input,
textarea,
select {
  transition-property: background-color, border-color, box-shadow, color,
    transform;
  transition-duration: 0.3s;
  transition-timing-function: ease;
}

/* ==========================================
   LOADING ANIMATION (Elite)
   ========================================== */

.theme-elite .spinner {
  border: 2px solid rgba(0, 229, 255, 0.2);
  border-top: 2px solid var(--color-accent);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

/* ==========================================
   ELITE MODE TEXT GLOW
   ========================================== */

.theme-elite h1,
.theme-elite h2,
.theme-elite h3,
.theme-elite h4,
.theme-elite h5,
.theme-elite h6 {
  text-shadow: 0 0 10px rgba(255, 200, 0, 0.5), 0 0 20px rgba(0, 240, 255, 0.2);
}

.theme-elite p {
  text-shadow: 0 0 4px rgba(255, 200, 0, 0.3);
}

.theme-elite label {
  text-shadow: 0 0 6px rgba(0, 240, 255, 0.3);
}

.theme-elite button {
  text-shadow: 0 0 4px rgba(255, 200, 0, 0.2);
}
